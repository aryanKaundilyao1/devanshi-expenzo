# EXPENZO Environment Variables (Frontend)
# Connect to your Supabase Project (Project Settings -> API)

# Supabase Project URL (e.g. https://xyzcompany.supabase.co)
VITE_SUPABASE_URL=https://your-project-id.supabase.co

# Supabase Anon / Publishable Key (Safe for browser / public use)
VITE_SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...

# Backend Mode: 'auto' (detects Supabase credentials), 'supabase' (forces Supabase), or 'mock' (offline demo)
VITE_BACKEND_MODE=auto

# Optional: Google Gemini API Key for Edge Functions AI Assistant (NEVER prefix with VITE_ in client code)
# GEMINI_API_KEY=your_gemini_api_key_here

